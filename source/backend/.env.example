# Configure these in Coolify Secret Manager only.
PORT=3000
DATABASE_URL=postgresql://<user>:<password>@<internal-db-host>:5432/atsh_website
DATABASE_SSL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt-hash>
JWT_SECRET=<random-secret-at-least-32-characters>
ALLOWED_ORIGINS=https://your-real-site-domain.example
COOKIE_SECURE=true
OPENAI_API_KEY=<secret-configured-in-Coolify-only>
OPENAI_MODEL=<model-enabled-for-the-OpenAI-project>
N8N_AD_APPROVED_PLAN_URL=<active-production-webhook-url>
N8N_AD_APPROVED_PLAN_TOKEN=<secret-configured-in-Coolify-only>
N8N_ALLOW_INTERNAL_HTTP=false

# Official site/account flows
PUBLIC_SITE_URL=https://your-real-site-domain.example
BREVO_API_KEY=<secret>
BREVO_SENDER_EMAIL=info@your-real-site-domain.example

# Domain search works without credentials through live registry RDAP (registration record only).
# OPTIONAL: Namecheap production API confirms registrar availability, premium flags, and prices.
# NO registration/purchase without verified quote and explicit approval.
# Namecheap requires a whitelisted static outbound IPv4; sandbox cannot confirm real availability.
NAMECHEAP_ENV=sandbox
NAMECHEAP_API_USER=<namecheap-api-username>
NAMECHEAP_USERNAME=<namecheap-username>
NAMECHEAP_API_KEY=<namecheap-secret>
NAMECHEAP_CLIENT_IP=<whitelisted-ipv4>

# WHM provisioning is disabled until independent verified payment and admin approval
ATSH_WHM_HOST=<whm-hostname>
ATSH_WHM_USER=<whm-user>
ATSH_WHM_API_TOKEN=<whm-token>
ATSH_WHM_ALLOWED_PLANS=<whm-package-list>
ATSH_WHM_PROVISIONING_ENABLED=false

# Payment provider adapter only: a gateway-specific signature verification integration is still required.
ATSH_VERIFIED_PAYMENT_SECRET=<unique-strong-internal-adapter-secret>

# Reliable event outbox from approved customer transitions
ATSH_N8N_EVENT_URL=https://your-n8n-domain.example/webhook/atsh-journey
ATSH_N8N_EVENT_TOKEN=<unique-strong-outbox-token>

# External staging preview pipeline; signed callbacks only
PREVIEW_DEPLOY_WEBHOOK=https://your-deployer.example/webhook/preview
PREVIEW_DEPLOY_SECRET=<unique-strong-preview-secret>
PREVIEW_ALLOWED_HOST_SUFFIX=previews.your-real-site-domain.example

# GPT cost control (aggregate, no conversation content logged)
ATSH_GPT_DAILY_REQUESTS=300
ATSH_GPT_DAILY_OUTPUT_TOKENS=100000
