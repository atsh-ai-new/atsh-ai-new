FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng libsndfile1 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir kokoro==0.9.4 soundfile numpy
WORKDIR /app
COPY egyptian_quality_trial.py ./
ENV PYTHONPATH=/model OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 CUDA_VISIBLE_DEVICES="" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TORCH_FORCE_WEIGHTS_ONLY_LOAD=1
USER 10001:10001
CMD ["python","-u","egyptian_quality_trial.py","/model","/auditions"]
