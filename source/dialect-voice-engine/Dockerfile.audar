FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 libsndfile1 build-essential cmake && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir piper-tts==1.3.0 llama-cpp-python neucodec soundfile
WORKDIR /app
COPY service.py audar_backend.py audition.py ./
USER 10001:10001
ENV OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HOME=/models/hf
CMD ["python","-u","service.py"]
